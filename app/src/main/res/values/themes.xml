<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema do app. O protótipo só tem versão clara, por isso não há values-night. -->
    <style name="Theme.UniforFit" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/azul</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorPrimaryContainer">@color/azul_claro</item>
        <item name="colorSecondary">@color/azul</item>
        <item name="colorAccent">@color/azul</item>
        <item name="android:windowBackground">@color/branco</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- O teclado empurra o conteúdo (as margens do teclado são tratadas na BaseActivity) -->
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- Splash (RF01): fundo azul desde o primeiro frame, sem "piscar" branco -->
    <style name="Theme.UniforFit.Splash">
        <item name="android:windowBackground">@color/azul</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/azul</item>
    </style>

    <!-- Pop-ups (Dialog com cartão branco arredondado + animação de zoom) -->
    <style name="UniforFitPopup" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowAnimationStyle">@style/UniforFitAnimacaoPopup</item>
        <item name="colorPrimary">@color/azul</item>
    </style>

    <style name="UniforFitAnimacaoPopup">
        <item name="android:windowEnterAnimation">@anim/popup_entrar</item>
        <item name="android:windowExitAnimation">@anim/popup_sair</item>
    </style>

    <!-- ===== Estilos UniforFit ===== -->

    <!-- Pai implícito dos estilos UniforFit.* (exigido pelo AAPT2) -->
    <style name="UniforFit" />

    <!-- Label acima de cada campo -->
    <style name="UniforFit.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/texto_label</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Campo de texto com borda arredondada -->
    <style name="UniforFit.Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/texto_titulo</item>
        <item name="android:textColorHint">@color/placeholder</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:imeOptions">actionNext</item>
    </style>

    <!-- Lista suspensa com o mesmo visual do campo -->
    <style name="UniforFit.ListaSuspensa">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@drawable/bg_lista_suspensa</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:popupBackground">@drawable/bg_card</item>
    </style>

    <!-- Botão azul principal -->
    <style name="UniforFit.BotaoPrimario">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/bg_botao_primario</item>
        <item name="android:textColor">@color/branco</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Botão azul-claro com texto azul (ações secundárias) -->
    <style name="UniforFit.BotaoSecundario" parent="UniforFit.BotaoPrimario">
        <item name="android:background">@drawable/bg_botao_secundario</item>
        <item name="android:textColor">@color/azul</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Botão vermelho (ações destrutivas) -->
    <style name="UniforFit.BotaoPerigo" parent="UniforFit.BotaoPrimario">
        <item name="android:background">@drawable/bg_botao_perigo</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Título das telas -->
    <style name="UniforFit.Titulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_titulo</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Subtítulo cinza -->
    <style name="UniforFit.Subtitulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- "ETAPA 1 DE 3" do onboarding -->
    <style name="UniforFit.Etapa">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:textColor">@color/azul</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Link azul ("← Voltar", "Esqueci minha senha"...) com área de toque de 48dp -->
    <style name="UniforFit.Link">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">@color/azul</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Cartão branco clicável das listas -->
    <style name="UniforFit.Cartao">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_card_clicavel</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Valor grande dos indicadores (cards de números) -->
    <style name="UniforFit.IndicadorValor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/azul</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="UniforFit.IndicadorRotulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/texto_cinza</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
