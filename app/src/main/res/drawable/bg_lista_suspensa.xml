<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo das listas suspensas (Spinner): campo arredondado + seta à direita -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/branco" />
            <stroke android:width="1.5dp" android:color="@color/borda_campo" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:width="20dp"
        android:height="20dp"
        android:drawable="@drawable/ic_seta_baixo"
        android:end="12dp"
        android:gravity="end|center_vertical" />
</layer-list>
