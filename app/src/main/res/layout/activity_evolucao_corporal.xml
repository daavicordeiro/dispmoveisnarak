<?xml version="1.0" encoding="utf-8"?>
<!-- Evolução Corporal (RF17). Vai dentro do uf_shell_aluno. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_cinza"
    tools:context=".ui.evolucao.EvolucaoCorporalActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="Evolução Corporal"
            android:textColor="@color/texto_escuro"
            android:textSize="22sp"
            android:textStyle="bold" />

        <include
            layout="@layout/view_abas_evolucao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_branco"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peso corporal (kg) — últimos 3 meses"
                android:textColor="@color/texto_cinza"
                android:textSize="12sp" />

            <br.edu.unifor.uniforfit.ui.comum.GraficoLinhaView
                android:id="@+id/graficoPeso"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- RF17.1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_branco"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvVariacaoPeso"
                    style="@style/UniforFit.IndicadorValor"
                    android:text="-4,2kg"
                    android:textColor="@color/verde"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvRotuloVariacao"
                    style="@style/UniforFit.IndicadorRotulo"
                    android:text="Peso perdido" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_branco"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvPesoAtual"
                    style="@style/UniforFit.IndicadorValor"
                    android:text="72kg"
                    android:textColor="@color/texto_escuro"
                    android:textSize="17sp" />

                <TextView
                    style="@style/UniforFit.IndicadorRotulo"
                    android:text="Peso atual" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_branco"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvImcAtual"
                    style="@style/UniforFit.IndicadorValor"
                    android:text="23,5"
                    android:textColor="@color/texto_escuro"
                    android:textSize="17sp" />

                <TextView
                    style="@style/UniforFit.IndicadorRotulo"
                    android:text="IMC atual" />
            </LinearLayout>
        </LinearLayout>

        <!-- RF17.4 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegistrarPeso"
            style="@style/UniforFit.BotaoSecundario"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:text="Registrar novo peso/IMC" />

        <!-- RF17.2 / RF17.3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="Fotos de progresso"
                android:textColor="@color/texto_escuro"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAdicionarFoto"
                android:layout_width="44dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_botao_primario"
                android:clickable="true"
                android:contentDescription="Adicionar foto de progresso"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/branco"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/listaFotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
