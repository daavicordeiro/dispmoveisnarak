<?xml version="1.0" encoding="utf-8"?>
<!-- Detalhe do Exercício (RF12). Vai dentro do uf_shell_fab (botão do assistente). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_escuro"
    android:fillViewport="true"
    tools:context=".ui.treino.DetalheExercicioActivity">

    <!-- O fundo escuro do ScrollView aparece só atrás da barra de status, emendando com a mídia -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/branco"
        android:orientation="vertical">

        <!-- Mídia demonstrativa (placeholder escuro do protótipo) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="@color/fundo_escuro">

            <TextView
                android:id="@+id/tvVoltar"
                style="@style/UniforFit.Link"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:text="← Voltar"
                android:textColor="@color/branco" />

            <TextView
                android:id="@+id/btnPlay"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circulo"
                android:clickable="true"
                android:contentDescription="Reproduzir vídeo demonstrativo"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="4dp"
                android:text="▶"
                android:textColor="@color/azul"
                android:textSize="22sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="96dp">

            <TextView
                android:id="@+id/tvNomeExercicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="Leg Press 45°"
                android:textColor="@color/texto_escuro"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="12dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/laranja" />

                <TextView
                    android:id="@+id/tvMaquina"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Máquina 12 — Setor de Pernas"
                    android:textColor="@color/azul"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Indicadores de prescrição (RF12.1) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_thumb"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvSeries"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textColor="@color/texto_escuro"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/UniforFit.IndicadorRotulo"
                        android:text="Séries" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_thumb"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvRepeticoes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        android:textColor="@color/texto_escuro"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/UniforFit.IndicadorRotulo"
                        android:text="Repetições" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_thumb"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvCarga"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="80 kg"
                        android:textColor="@color/texto_escuro"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/UniforFit.IndicadorRotulo"
                        android:text="Carga" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_thumb"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvDescanso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60s"
                        android:textColor="@color/texto_escuro"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/UniforFit.IndicadorRotulo"
                        android:text="Descanso" />
                </LinearLayout>
            </LinearLayout>

            <!-- RF12.2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:text="Como executar"
                android:textColor="@color/texto_escuro"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvComoExecutar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/texto_cinza"
                android:textSize="13sp" />

            <!-- RF12.3 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPersonalizarCarga"
                style="@style/UniforFit.BotaoPrimario"
                android:layout_marginTop="20dp"
                android:text="Personalizar carga"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
