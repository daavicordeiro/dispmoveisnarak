<?xml version="1.0" encoding="utf-8"?>
<!-- Execução da Série (RF14) — tema escuro -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_escuro"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ui.treino.ExecucaoSerieActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Encerrar pede confirmação (pop-up) -->
        <TextView
            android:id="@+id/tvVoltar"
            style="@style/UniforFit.Link"
            android:text="✕  Encerrar"
            android:textColor="#B8C0D6" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvProgressoTreino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exercício 1 de 4"
            android:textColor="#B8C0D6"
            android:textSize="12sp" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvExercicioSerie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:text="Leg Press 45° · Série 2 de 4"
        android:textColor="@color/branco"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMaquinaSerie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Máquina 12 — Leg Press"
        android:textColor="#8FA2FF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvCronometro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:text="00:45"
        android:textColor="@color/branco"
        android:textSize="76sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="28dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRepsSerie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textColor="@color/branco"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reps"
                android:textColor="#B8C0D6"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCargaSerie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80kg"
                android:textColor="@color/branco"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carga"
                android:textColor="#B8C0D6"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <!-- RF14.2 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPausar"
            style="@style/UniforFit.BotaoPrimario"
            android:layout_width="0dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_botao_branco"
            android:text="Pausar"
            android:textColor="@color/texto_escuro"
            android:textSize="15sp" />

        <!-- RF14.3 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConcluirSerie"
            style="@style/UniforFit.BotaoPrimario"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Concluir série"
            android:textSize="15sp" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvProximo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Próximo: Cadeira Extensora"
        android:textColor="#B8C0D6"
        android:textSize="12sp" />
</LinearLayout>
