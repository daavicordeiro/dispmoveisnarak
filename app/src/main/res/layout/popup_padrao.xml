<?xml version="1.0" encoding="utf-8"?>
<!-- Pop-up padrão do app, no visual do "Popup — Treino Concluído" (RF15).
     Montado pela classe Popup: ícone, título, mensagem, conteúdo extra opcional e até dois botões. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_popup"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="26dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/popupIcone"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/verde"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/popupTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:textColor="@color/texto_titulo"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/popupMensagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/popupConteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/popupPrimario"
            style="@style/UniforFit.BotaoPrimario"
            android:layout_marginTop="20dp"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/popupSecundario"
            style="@style/UniforFit.Link"
            android:layout_marginTop="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/texto_secundario"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
