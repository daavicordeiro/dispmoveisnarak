<?xml version="1.0" encoding="utf-8"?>
<!-- Notificações (RF20) e Notificações — Estado Vazio (RF20.4) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uf_fundo"
    tools:context=".ui.notificacoes.NotificacoesActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp">

        <include
            android:id="@+id/btnVoltar"
            layout="@layout/uf_view_botao_voltar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/uf_notificacoes_titulo"
                android:textColor="@color/uf_texto"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLimpar"
                style="@style/UniforFit.Link"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:text="Limpar" />
        </LinearLayout>

        <!-- RF20.4 — estado vazio -->
        <LinearLayout
            android:id="@+id/tvVazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@color/uf_azul_claro"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_card" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nenhum aviso por enquanto"
                    android:textColor="@color/uf_texto"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Avisos sobre treinos, recordes e recados do professor aparecem aqui."
                    android:textColor="@color/uf_texto_secundario"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotificacoes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingBottom="96dp"
            tools:itemCount="4"
            tools:listitem="@layout/uf_item_notificacao" />
    </LinearLayout>

    <include
        android:id="@+id/fabAssistente"
        layout="@layout/uf_view_fab_assistente"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp" />
</FrameLayout>
