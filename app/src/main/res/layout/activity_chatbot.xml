<?xml version="1.0" encoding="utf-8"?>
<!-- Assistente Unifor Fit (RF09.5.1 a RF09.5.4) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:orientation="vertical"
    tools:context=".ui.chatbot.ChatbotActivity">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/branco"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- RF11.1 -->
        <include
            android:id="@+id/btnVoltar"
            layout="@layout/uf_view_botao_voltar" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_circulo"
            android:backgroundTint="@color/azul_claro"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="✨"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="Assistente Unifor Fit"
                android:textColor="@color/texto_escuro"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_circulo"
                    android:backgroundTint="@color/verde" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="online agora"
                    android:textColor="@color/verde"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borda" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fundo_cinza">

        <ScrollView
            android:id="@+id/scrollChat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/listaMensagens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </ScrollView>

        <!-- RF09.5.2 — instruções no meio da tela (somem na primeira mensagem) -->
        <LinearLayout
            android:id="@+id/painelBoasVindas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/azul_claro"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="✨"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Como posso ajudar?"
                android:textColor="@color/texto_escuro"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Tire dúvidas sobre treinos, exercícios ou sua evolução a qualquer hora."
                android:textColor="@color/texto_cinza"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/sugestao1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_clicavel"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:text="Como faço o Leg Press corretamente?"
                android:textColor="@color/azul"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/sugestao2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_clicavel"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:text="Como personalizo a minha carga?"
                android:textColor="@color/azul"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/sugestao3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_clicavel"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:text="Como funciona o ranking?"
                android:textColor="@color/azul"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- RF09.5.3 — barra de texto + enviar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/branco"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <EditText
            android:id="@+id/etMensagemChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/uf_bg_input"
            android:hint="Escreva sua dúvida..."
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/texto_escuro"
            android:textColorHint="@color/placeholder"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnEnviarChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_fab"
            android:contentDescription="Enviar mensagem"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_enviar" />
    </LinearLayout>
</LinearLayout>
