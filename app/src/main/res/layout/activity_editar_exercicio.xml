<?xml version="1.0" encoding="utf-8"?>
<!-- Editar Exercício (RF38) — também usada para cadastrar um novo exercício (RF37.4) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:fillViewport="true"
    tools:context=".gestor.EditarExercicioActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvVoltar"
            style="@style/UniforFit.Link"
            android:text="← Exercícios"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTitulo"
            style="@style/UniforFit.Titulo"
            android:accessibilityHeading="true"
            android:text="Editar Exercício"
            android:textSize="24sp" />

        <!-- RF38.5 -->
        <TextView
            android:id="@+id/btnAdicionarMidia"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_botao_secundario"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="📷  Adicionar foto/vídeo do exercício"
            android:textColor="@color/azul"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgMidia"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_thumb"
            android:contentDescription="Mídia demonstrativa do exercício"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- RF38.1 -->
        <TextView
            style="@style/UniforFit.Label"
            android:labelFor="@id/etNomeExercicio"
            android:text="Nome do exercício" />

        <EditText
            android:id="@+id/etNomeExercicio"
            style="@style/UniforFit.Campo"
            android:hint="Ex: Leg Press 45°"
            android:importantForAutofill="no"
            android:inputType="textCapSentences" />

        <!-- RF38.2 -->
        <TextView
            style="@style/UniforFit.Label"
            android:labelFor="@id/etMaquina"
            android:text="Máquina/Equipamento (nomenclatura padrão)" />

        <EditText
            android:id="@+id/etMaquina"
            style="@style/UniforFit.Campo"
            android:hint="Ex: Máquina 12 — Leg Press"
            android:importantForAutofill="no"
            android:inputType="textCapSentences" />

        <!-- RF38.3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/UniforFit.Label"
                    android:text="Grupo muscular" />

                <Spinner
                    android:id="@+id/spGrupo"
                    style="@style/UniforFit.ListaSuspensa"
                    android:contentDescription="Grupo muscular" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/UniforFit.Label"
                    android:text="Setor da academia" />

                <Spinner
                    android:id="@+id/spSetor"
                    style="@style/UniforFit.ListaSuspensa"
                    android:contentDescription="Setor da academia" />
            </LinearLayout>
        </LinearLayout>

        <!-- RF38.4 -->
        <TextView
            style="@style/UniforFit.Label"
            android:labelFor="@id/etInstrucoes"
            android:text="Instruções de execução" />

        <EditText
            android:id="@+id/etInstrucoes"
            style="@style/UniforFit.Campo"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="Descreva como executar corretamente"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="6"
            android:minHeight="96dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <!-- RF38.6 — só habilita com os campos obrigatórios preenchidos -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSalvarExercicio"
            style="@style/UniforFit.BotaoPrimario"
            android:text="Salvar exercício"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
