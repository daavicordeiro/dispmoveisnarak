<?xml version="1.0" encoding="utf-8"?>
<!-- Calculadora de IMC (RF18). Vai dentro do uf_shell_fab (botão do assistente). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    tools:context=".ui.evolucao.CalculadoraImcActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="96dp">

        <!-- RF11.1 -->
        <include
            android:id="@+id/btnVoltar"
            layout="@layout/uf_view_botao_voltar" />

        <TextView
            style="@style/UniforFit.Titulo"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:text="Calculadora de IMC"
            android:textSize="24sp" />

        <TextView
            style="@style/UniforFit.Subtitulo"
            android:layout_marginBottom="20dp"
            android:text="Descubra seu Índice de Massa Corporal"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/UniforFit.Label"
                    android:labelFor="@id/etPeso"
                    android:text="Peso (kg)" />

                <EditText
                    android:id="@+id/etPeso"
                    style="@style/UniforFit.Campo"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLength="5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/UniforFit.Label"
                    android:labelFor="@id/etAltura"
                    android:text="Altura (cm)" />

                <EditText
                    android:id="@+id/etAltura"
                    style="@style/UniforFit.Campo"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3" />
            </LinearLayout>
        </LinearLayout>

        <!-- RF18.2 — resultado em destaque -->
        <LinearLayout
            android:id="@+id/cardResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_card_carga"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvImc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23,5"
                android:textColor="@color/azul"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClassificacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/verde"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="4dp"
                android:text="Peso normal"
                android:textColor="@color/branco"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCalcular"
            style="@style/UniforFit.BotaoPrimario"
            android:text="Calcular"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
