<?xml version="1.0" encoding="utf-8"?>
<!-- Card de notificação. Fundo azul-claro = não lida; cinza-claro = lida (definido no Adapter). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNotificacao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/uf_azul_claro"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/uf_texto"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Hora do treino!" />

        <TextView
            android:id="@+id/tvMensagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/uf_texto_secundario"
            android:textSize="13sp"
            tools:text="Seu Treino C — Pernas te espera hoje." />

        <TextView
            android:id="@+id/tvTempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/uf_texto_secundario"
            android:textSize="11sp"
            tools:text="há 2h" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
