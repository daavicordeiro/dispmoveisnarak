<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet "câmera ou galeria" (RF17.3 foto de progresso / RF38.5 mídia do exercício) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_alca_bottom_sheet" />

    <TextView
        android:id="@+id/tvTituloMidia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:accessibilityHeading="true"
        android:text="Adicionar foto de progresso"
        android:textColor="@color/texto_titulo"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Escolha de onde vem a imagem"
        android:textColor="@color/texto_secundario"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/opcaoCamera"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_clicavel"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="📷   Tirar foto com a câmera"
        android:textColor="@color/texto_titulo"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/opcaoGaleria"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card_clicavel"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="🖼   Escolher da galeria"
        android:textColor="@color/texto_titulo"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/opcaoCancelar"
        style="@style/UniforFit.Link"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="Cancelar"
        android:textColor="@color/texto_secundario" />
</LinearLayout>
