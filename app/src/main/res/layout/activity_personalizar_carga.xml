<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/branco">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="56dp"
            android:paddingEnd="18dp"
            android:paddingBottom="96dp">

            <TextView
                style="@style/UniforFit.Titulo"
                android:textSize="22sp"
                android:text="Personalizar carga" />

            <TextView
                android:id="@+id/txtExercicio"
                style="@style/UniforFit.Subtitulo"
                android:textSize="13sp"
                android:text="Leg Press 45° · ajuste conforme sua evolução" />

            <!-- Card azul claro com o valor e os controles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_carga"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp">

                <TextView
                    android:id="@+id/txtCarga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="80 kg"
                    android:textColor="@color/azul_primario"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnDiminuir"
                        android:layout_width="56dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_botao_ajuste"
                        android:contentDescription="Diminuir carga"
                        android:gravity="center"
                        android:text="–"
                        android:textColor="@color/azul_primario"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/seekCarga"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="300"
                        android:progress="80"
                        android:progressDrawable="@drawable/seekbar_trilha"
                        android:thumb="@drawable/seekbar_thumb"
                        android:splitTrack="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />

                    <TextView
                        android:id="@+id/btnAumentar"
                        android:layout_width="56dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_botao_ajuste"
                        android:contentDescription="Aumentar carga"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/azul_primario"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtUltimaCarga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Última carga registrada: 75 kg (+5kg hoje)"
                android:textColor="@color/verde_sucesso"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSalvarCarga"
                style="@style/UniforFit.BotaoPrimario"
                android:layout_marginTop="32dp"
                android:textSize="15sp"
                android:text="Salvar carga" />

        </LinearLayout>
    </ScrollView>

    <!-- Botão flutuante ✨ no canto inferior direito -->
    <TextView
        android:id="@+id/fabAssistente"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_fab"
        android:contentDescription="Assistente"
        android:elevation="6dp"
        android:gravity="center"
        android:text="✨"
        android:textSize="18sp" />

</FrameLayout>
