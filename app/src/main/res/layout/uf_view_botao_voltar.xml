<?xml version="1.0" encoding="utf-8"?>
<!-- Botão "voltar" em formato de pílula azul. Use com <include android:id="@+id/btnVoltar" ... /> -->
<com.google.android.material.button.MaterialButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="26dp"
    android:contentDescription="@string/uf_voltar"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:minWidth="0dp"
    android:minHeight="0dp"
    android:padding="0dp"
    app:backgroundTint="@color/uf_azul"
    app:cornerRadius="13dp"
    app:icon="@drawable/uf_ic_voltar"
    app:iconGravity="textStart"
    app:iconPadding="0dp"
    app:iconSize="16dp"
    app:iconTint="@color/uf_branco" />
