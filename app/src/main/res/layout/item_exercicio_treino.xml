<?xml version="1.0" encoding="utf-8"?>
<!-- Exercício na tela Detalhe do Treino: nome, máquina (RF11.5), prescrição e botão de detalhes (RF11.7) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardExercicio"
    style="@style/UniforFit.Cartao">

    <View
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_thumb" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_escuro"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="12dp"
                android:layout_height="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/laranja" />

            <TextView
                android:id="@+id/tvMaquina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/azul"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPrescricao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texto_cinza"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnDetalhes"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Ver detalhes do exercício"
        android:padding="10dp"
        android:src="@drawable/ic_info" />
</LinearLayout>
