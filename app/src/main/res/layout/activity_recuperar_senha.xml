<?xml version="1.0" encoding="utf-8"?>
<!-- Recuperar Senha (RF04) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:fillViewport="true"
    tools:context=".ui.auth.RecuperarSenhaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="120dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/UniforFit.Titulo"
            android:accessibilityHeading="true"
            android:text="Recuperar senha"
            android:textSize="24sp" />

        <TextView
            style="@style/UniforFit.Subtitulo"
            android:text="Informe seu R.A. e enviaremos um link para o e-mail institucional cadastrado."
            android:textSize="13sp" />

        <TextView
            style="@style/UniforFit.Label"
            android:layout_marginTop="24dp"
            android:labelFor="@id/etRa"
            android:text="R.A. (Registro Acadêmico)" />

        <EditText
            android:id="@+id/etRa"
            style="@style/UniforFit.Campo"
            android:layout_marginBottom="4dp"
            android:hint="Ex: 2201234567"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="10" />

        <TextView
            android:id="@+id/tvErro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/vermelho"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEnviarLink"
            style="@style/UniforFit.BotaoPrimario"
            android:layout_marginTop="16dp"
            android:text="Enviar link de recuperação"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvVoltar"
            style="@style/UniforFit.Link"
            android:layout_marginTop="8dp"
            android:text="← Voltar para o login" />
    </LinearLayout>
</ScrollView>
