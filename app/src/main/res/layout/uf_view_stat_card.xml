<?xml version="1.0" encoding="utf-8"?>
<!-- Mini-card de estatística do perfil (#4 Ranking, 32 Treinos, 740 Pontos) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="72dp"
    app:cardBackgroundColor="@color/uf_branco"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="72dp"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tvValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/uf_azul"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="#4" />

        <TextView
            android:id="@+id/tvRotulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/uf_texto_secundario"
            android:textSize="11sp"
            tools:text="Ranking" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
