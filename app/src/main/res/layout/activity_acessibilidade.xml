<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_cinza">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvVoltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="← Perfil"
                android:textColor="@color/azul"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Acessibilidade"
                android:textColor="@color/texto_escuro"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ajuste o tamanho do texto para facilitar a leitura."
                android:textColor="@color/texto_cinza"
                android:textSize="12sp" />

            <!-- Card 1: Tamanho da fonte -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tamanho da fonte"
                    android:textColor="@color/texto_escuro"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgFonte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="#F1F3F9"
                    android:orientation="horizontal"
                    android:padding="4dp">

                <RadioButton
                    android:id="@+id/rbPequena"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmento_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Pequena"
                    android:textColor="@color/cor_segmento"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbNormal"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmento_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Normal"
                    android:textColor="@color/cor_segmento"
                    android:textSize="11sp"
                    android:checked="true"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbGrande"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmento_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Grande"
                    android:textColor="@color/cor_segmento"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbEnorme"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmento_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Enorme"
                    android:textColor="@color/cor_segmento"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                </RadioGroup>
            </LinearLayout>

            <!-- Card 2: Veja como fica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="80dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:text="Veja como fica"
                    android:textColor="@color/texto_escuro"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/linhaPequena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#F5F6FA"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/seloPequena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="#FFFFFF"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="PEQUENA"
                    android:textColor="@color/texto_cinza"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textoPequena"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Treino de hoje: Leg Press 45°"
                    android:textColor="@color/texto_escuro"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linhaNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@color/azul_claro"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/seloNormal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/azul"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="NORMAL"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textoNormal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Treino de hoje: Leg Press 45°"
                    android:textColor="@color/texto_escuro"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linhaGrande"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#F5F6FA"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/seloGrande"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="#FFFFFF"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="GRANDE"
                    android:textColor="@color/texto_cinza"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textoGrande"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Treino de hoje: Leg Press 45°"
                    android:textColor="@color/texto_escuro"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linhaEnorme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#F5F6FA"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/seloEnorme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="#FFFFFF"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="ENORME"
                    android:textColor="@color/texto_cinza"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textoEnorme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Treino de hoje: Leg Press 45°"
                    android:textColor="@color/texto_escuro"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Botão flutuante do chatbot (canto inferior direito) -->
    <TextView
        android:id="@+id/btnChatbot"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_fab"
        android:clickable="true"
        android:contentDescription="@string/uf_assistente"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center"
        android:text="✨"
        android:textColor="#FFFFFF"
        android:textSize="22sp" />

</FrameLayout>
