<?xml version="1.0" encoding="utf-8"?>
<!-- Início (RF09). Vai dentro do uf_shell_aluno (assistente + navbar). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_cinza"
    tools:context=".ui.home.HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="96dp">

        <!-- Saudação + sino de notificações (RF09 / RF20) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSaudacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Boa tarde,"
                    android:textColor="@color/texto_cinza"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvNomeAluno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="Giuseppe"
                    android:textColor="@color/texto_escuro"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnNotificacoes"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circulo"
                android:backgroundTint="@color/azul_claro"
                android:clickable="true"
                android:contentDescription="Notificações"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sino" />

                <View
                    android:id="@+id/badgeNotificacoes"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_circulo"
                    android:backgroundTint="@color/vermelho" />
            </FrameLayout>
        </LinearLayout>

        <!-- Indicadores (RF09.1) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_branco"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTreinosMes"
                    style="@style/UniforFit.IndicadorValor"
                    android:text="12" />

                <TextView
                    style="@style/UniforFit.IndicadorRotulo"
                    android:text="Treinos este mês" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_branco"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvCargaEvoluida"
                    style="@style/UniforFit.IndicadorValor"
                    android:text="+3,5kg" />

                <TextView
                    style="@style/UniforFit.IndicadorRotulo"
                    android:text="Carga total evoluída" />
            </LinearLayout>
        </LinearLayout>

        <!-- Treino de hoje (RF09.2 / RF09.3) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="Treino de hoje"
            android:textColor="@color/texto_escuro"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cardTreinoHoje"
            style="@style/UniforFit.Cartao"
            android:padding="14dp">

            <View
                android:id="@+id/thumbTreinoHoje"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_thumb" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTreinoHojeNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Treino C — Pernas"
                    android:textColor="@color/texto_escuro"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTreinoHojeInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="4 exercícios · ~55 min"
                    android:textColor="@color/texto_cinza"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="›"
                android:textColor="@color/azul"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- Seu ranking (RF09.4) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="Seu ranking"
            android:textColor="@color/texto_escuro"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cardRanking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_botao_primario"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvPosicaoRanking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#4"
                android:textColor="@color/branco"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Você subiu 2 posições"
                    android:textColor="@color/branco"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.85"
                    android:text="Continue treinando para subir mais"
                    android:textColor="@color/branco"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
