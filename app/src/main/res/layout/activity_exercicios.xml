<?xml version="1.0" encoding="utf-8"?>
<!-- Exercícios (RF37) — catálogo com a nomenclatura padrão das máquinas -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_cinza"
    tools:context=".gestor.ExerciciosActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvVoltar"
            style="@style/UniforFit.Link"
            android:layout_marginTop="8dp"
            android:text="← Painel"
            android:textSize="12sp" />

        <!-- Título + botão "+" (RF37.4) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="Exercícios"
                android:textColor="@color/texto_escuro"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNovoExercicio"
                android:layout_width="44dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_botao_primario"
                android:clickable="true"
                android:contentDescription="Cadastrar novo exercício"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Filtros por grupo muscular (RF37.1) — o ativo fica azul -->
        <LinearLayout
            android:id="@+id/filtros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filtroTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/azul"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="Todos"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filtroPernas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/azul_claro"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="Pernas"
                android:textColor="@color/texto_cinza"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filtroCostas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/azul_claro"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="Costas"
                android:textColor="@color/texto_cinza"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filtroPeito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/azul_claro"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="Peito"
                android:textColor="@color/texto_cinza"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lista de exercícios (RF37.2), preenchida pela Activity -->
        <LinearLayout
            android:id="@+id/listaExercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
