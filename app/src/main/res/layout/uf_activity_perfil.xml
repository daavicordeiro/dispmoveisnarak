<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/uf_fundo_suave"
    android:orientation="vertical"
    tools:context=".ui.perfil.PerfilActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="116dp"
                android:paddingEnd="20dp"
                android:paddingBottom="96dp">

                <!-- Avatar: por enquanto só o círculo; depois carregar a foto do backend aqui -->
                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/uf_bg_avatar"
                    android:contentDescription="@string/uf_foto_perfil"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tvNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:accessibilityHeading="true"
                    android:textColor="@color/uf_texto"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Giuseppe Chinelate" />

                <TextView
                    android:id="@+id/tvRa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/uf_texto_secundario"
                    android:textSize="14sp"
                    tools:text="R.A. 2201234567" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/statRanking"
                        layout="@layout/uf_view_stat_card" />

                    <include
                        android:id="@+id/statTreinos"
                        layout="@layout/uf_view_stat_card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />

                    <include
                        android:id="@+id/statPontos"
                        layout="@layout/uf_view_stat_card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/itemEditarAnamnese"
                    style="@style/UfItemMenuPerfil"
                    android:layout_marginTop="20dp"
                    android:text="@string/uf_editar_anamnese" />

                <TextView
                    android:id="@+id/itemFaleProfessor"
                    style="@style/UfItemMenuPerfil"
                    android:text="@string/uf_fale_professor_menu" />

                <TextView
                    android:id="@+id/itemAcessibilidade"
                    style="@style/UfItemMenuPerfil"
                    android:text="@string/uf_acessibilidade" />

                <TextView
                    android:id="@+id/itemSair"
                    style="@style/UfItemMenuPerfil"
                    android:text="@string/uf_sair_conta" />
            </LinearLayout>
        </ScrollView>

        <include
            android:id="@+id/fabAssistente"
            layout="@layout/uf_view_fab_assistente"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/uf_borda" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/uf_branco"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/uf_bottom_nav_cor"
        app:itemTextColor="@color/uf_bottom_nav_cor"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/uf_menu_bottom_nav" />
</LinearLayout>
