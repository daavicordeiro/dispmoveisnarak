rules_version = '2';

// Regras iniciais: apenas usuários autenticados (Firebase Authentication)
// podem ler e escrever. Refinar por coleção (alunos, gestores, treinos...)
// quando as coleções forem criadas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
